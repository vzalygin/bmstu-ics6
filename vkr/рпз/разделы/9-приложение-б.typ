  columns: (1.1fr, 0.9fr, 1.6fr, 1.5fr),
  table.header(cc[ Пример текста ошибки ], cc[ Ситуация ], cc[ Причина ], cc[ Способ исправления ]),
  cc[ error unexpected argument "--foo" found ], cc[ Неизвестный флаг ], ccl[ При вызове указан параметр, не поддерживаемый компилятором. ], ccl[ Проверить~ написание параметра и использовать один~из~флагов, приведённых~в руководстве. ],
  cc[ error File not found. (os error 2) ], cc[ Входной файл не найден ], ccl[ Переданный~путь~не соответствует существующему файлу. ], ccl[ Проверить путь до файла и права доступа к нему. ],
  cc[ error syntax error: 0: at line 1 ], cc[ Синтаксическая ошибка ], ccl[ Текст программы не соответствует грамматике языка Cat. ], ccl[ Исправить место ошибки: закрыть цитату, завершить определение или удалить неизвестный символ. ],
  cc[ error typing error: unknown declaration foo ], cc[ Неизвестное имя ], ccl[ В программе используется слово, для которого нет встроенной команды или пользовательского определения. ], ccl[ Проверить имя слова либо добавить соответствующее определение. ],
  cc[ error typing error: incompatible types (A -> A) and int ], cc[ Несовпадение типов ], ccl[ Команда получает значение неподходящего типа с вершины стека. ], ccl[ Проверить порядок команд и типы значений, которые они помещают на стек. ],
  cc[ error logic error: main function must has no parameters, but found 1 ], cc[ Исчерпание стека ], ccl[ Команда пытается получить значение, которого нет на стеке. ], ccl[ Добавить необходимые операнды перед командой или изменить порядок операций. ],
))[ Основные диагностические ситуации ] <прил-б-ошибки>
